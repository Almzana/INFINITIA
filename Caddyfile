# Public entry point in production: HTTPS with an automatic Let's Encrypt certificate for $DOMAIN
# (DNS for the domain must point at this server, and ports 80/443 must be open).
# With DOMAIN=localhost Caddy uses its own local CA instead — handy for testing (browsers will warn).
{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		# Browsers must only ever use HTTPS for this site from now on
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Caddy replaces any X-Forwarded-For the client sent with the real client address
	reverse_proxy web:80
}
